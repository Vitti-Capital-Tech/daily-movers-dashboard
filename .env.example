# Postgres connection string.
#
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Use the "Connection pooling" URI (port 6543) for the app; drizzle-kit
# migrations are happier on the direct connection (port 5432).
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres"

# Supabase project credentials (added when auth + PDF storage land).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Anthropic API key -- only needed once PDF extraction is wired up.
ANTHROPIC_API_KEY=""
