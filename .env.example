# Postgres connection string.
#
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Use the POOLER host, not db.<ref>.supabase.co -- the direct host is IPv6-only
# and unreachable from many networks. Note the username is postgres.<ref>.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Signs the session cookie. Any 32+ char random string; rotating it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Supabase project credentials. Not used for sign-in (that's a signed cookie) --
# kept for PDF file storage later.
# The anon key is shipped to the browser by design; it is safe because every
# table has RLS enabled with no policies. See README -> "Why RLS has no policies".
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Anthropic API key & model for automated PDF research extraction.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Server-side only -- bypasses RLS. Needed for report PDF upload/download
# (private Supabase Storage bucket). Never NEXT_PUBLIC_*, never committed.
# Supabase -> Project Settings -> API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=""
