# Postgres connection string.
#
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Use the POOLER host, not db.<ref>.supabase.co -- the direct host is IPv6-only
# and unreachable from many networks. Note the username is postgres.<ref>.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Signs the session cookie. Any 32+ char random string; rotating it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Secret passcode for the 2 authorized editors to unlock Admin (write) mode.
# Viewers browse in read-only mode by default with no login needed.
ADMIN_PASSCODE="your-secure-admin-passcode"

# Supabase project credentials. Not used for sign-in (that's a signed cookie) --
# kept for PDF file storage later.
# The anon key is shipped to the browser by design; it is safe because every
# table has RLS enabled with no policies. See README -> "Why RLS has no policies".
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Anthropic API key & models.
#
# ANTHROPIC_MODEL is the extraction model: it reads an uploaded Daily Mover PDF
# and copies fields out of it, which is close to transcription.
#
# ANTHROPIC_DRAFT_MODEL is the Mover Studio model: it chooses which of the day's
# forty movers is worth covering, reads ~25 price-sensitive announcements, and
# writes the report. That is judgment rather than transcription, and it runs at a
# much larger input size. See src/lib/ai/client.ts.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_DRAFT_MODEL="claude-sonnet-5"

# Shared secret for the scheduled Daily Mover draft. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`; without it, /api/cron/daily-mover
# refuses every request rather than leaving an endpoint open that anyone could
# use to spend the Claude budget. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Server-side only -- bypasses RLS. Needed for report PDF upload/download
# (private Supabase Storage bucket). Never NEXT_PUBLIC_*, never committed.
# Supabase -> Project Settings -> API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=""
